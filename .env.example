# ── Default provider: Anthropic (full capability) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OLYMPUS_MODEL=claude-opus-4-8

# ── Or any OpenAI-compatible provider (bring your own model) ───────────
# OLYMPUS_PROVIDER=openai
# OLYMPUS_MODEL=gpt-4o                       # or gemini-..., llama3, ...
# OLYMPUS_API_KEY=sk-...                     # OPENAI_API_KEY also works
# OLYMPUS_BASE_URL=https://api.openai.com/v1 # Groq/OpenRouter/Ollama/... URL

# ── Use MULTIPLE keys together (best of each, as one) ──────────────────
# Add extra frontier models; Olympus runs each pipeline stage on whichever
# model is strongest for it (e.g. reasoning on Claude, coding on GPT). It's
# not a switch — they compose. `olympus models` shows the assignment.
# OLYMPUS_MODELS=[{"provider":"openai","model":"gpt-5","api_key":"sk-..."}]

# ── Optional ────────────────────────────────────────────────────────────
# OLYMPUS_MEMORY_DIR=./memory
# OLYMPUS_AUDIT_EVERY_CHATS=20               # self-audit cadence (0 = off)
# Budget guard — protects YOUR API bill (BYOK), never a charge from us. Olympus
# pauses new requests once today's estimated spend reaches this (0 = no cap).
# Also settable at runtime: `olympus budget <amount>` (which takes precedence).
# OLYMPUS_DAILY_BUDGET=5
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_CHAT_IDS=12345,67890
# TELEGRAM_NOTIFY_CHAT_ID=12345

# ── Talk to Olympus on WhatsApp (official Cloud API) ────────────────────
# Create a Meta app + WhatsApp product, then `olympus whatsapp` serves the
# webhook (put it behind HTTPS and point Meta's webhook at https://host/webhook).
# WHATSAPP_ACCESS_TOKEN=EAAG...               # Graph API token
# WHATSAPP_PHONE_NUMBER_ID=123456789          # the sending number's ID
# WHATSAPP_VERIFY_TOKEN=any-secret-you-choose # echoed during webhook setup
# WHATSAPP_ALLOWED_NUMBERS=15551234567        # restrict who may talk to it
# WHATSAPP_APP_SECRET=...                      # verify inbound signatures (optional)

# ── Auto-file upgrade proposals as GitHub issues ────────────────────────
# GITHUB_TOKEN=ghp_...                       # needs Issues write access
# GITHUB_REPO=maadjiba24-afk/Olympus-

# ── Hosted web instance protection ──────────────────────────────────────
# OLYMPUS_ACCESS_TOKEN=choose-a-secret       # require token in the web UI
# OLYMPUS_RATE_LIMIT=8                       # chat requests per IP per minute
# OLYMPUS_MAX_CONCURRENT_CALLS=6             # process-wide model-call cap
# OLYMPUS_JUDGE_MODEL=claude-sonnet-4-6      # benchmark judge (≠ tuned model)
# OLYMPUS_RETAIN_DAYS=30                     # keep trace/usage files this long

# ── Connectors: MCP servers & custom plugins ────────────────────────────
# Configure MCP servers in memory/connectors.json (see examples/) or inline:
# OLYMPUS_MCP_SERVERS={"servers":[{"name":"tavily","url":"https://mcp.tavily.com/mcp/","type":"data","auth_env":"TAVILY_MCP_TOKEN","specialists":["argus"]}]}
# TAVILY_MCP_TOKEN=tvly-...                  # token referenced by auth_env
# OLYMPUS_PLUGINS_DIR=./plugins              # local custom-connector plugins
# Action MCP servers are INERT until named here (double gate, like email):
# OLYMPUS_MCP_ACTION_ALLOWLIST=github,linear

# ── Connect Google with OAuth (self-serve, multi-user) ──────────────────
# Create an OAuth client in Google Cloud Console, then set these. Users click
# "Connect Google" in the web UI; tokens are stored ENCRYPTED in the vault.
# OLYMPUS_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# OLYMPUS_GOOGLE_CLIENT_SECRET=...
# OLYMPUS_GOOGLE_REDIRECT=http://localhost:8484/oauth/google/callback
# OLYMPUS_SECRET_KEY=any-strong-stable-secret   # encrypts stored credentials

# ── Real database (optional — defaults to local files) ──────────────────
# Set a Postgres URL to persist the vault/state in a database instead of files.
# OLYMPUS_DATABASE_URL=postgresql://user:pass@host:5432/olympus

# ── Durable memory (on by default) ──────────────────────────────────────
# OLYMPUS_MEMORY=0                           # turn off learning entirely
# Optional semantic recall: point at ANY OpenAI-compatible /embeddings endpoint
# (OpenAI, a local Ollama/LM Studio server, ...). Off unless a model is set;
# retrieval stays purely lexical otherwise.
# OLYMPUS_EMBED_MODEL=text-embedding-3-small
# OLYMPUS_EMBED_BASE_URL=https://api.openai.com/v1   # or http://localhost:11434/v1
# OLYMPUS_EMBED_API_KEY=sk-...                # falls back to OLYMPUS_API_KEY/OPENAI_API_KEY

# ── Gmail (direct token — alternative to the OAuth flow above) ───────────
# Connect a Google account so Angelos can read the inbox and PREPARE replies
# (sending always goes through the approval gate). Short-lived token for
# testing, or a refresh token + client creds for unattended auto-refresh.
# GMAIL_ACCESS_TOKEN=ya29....
# GMAIL_REFRESH_TOKEN=1//...
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...

# ── Action tools (disabled until configured) ────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=you@gmail.com
# OLYMPUS_EMAIL_ALLOWLIST=you@gmail.com      # the ONLY addresses it may email
# OLYMPUS_WEBHOOKS=poster=https://hooks.zapier.com/...,notify=https://...
