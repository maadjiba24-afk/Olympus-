# ── Default provider: Anthropic (full capability) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OLYMPUS_MODEL=claude-opus-4-8

# ── Or any OpenAI-compatible provider (bring your own model) ───────────
# OLYMPUS_PROVIDER=openai
# OLYMPUS_MODEL=gpt-4o                       # or gemini-..., llama3, ...
# OLYMPUS_API_KEY=sk-...                     # OPENAI_API_KEY also works
# OLYMPUS_BASE_URL=https://api.openai.com/v1 # Groq/OpenRouter/Ollama/... URL

# ── Use MULTIPLE keys together (best of each, as one) ──────────────────
# Add extra frontier models; Olympus runs each pipeline stage on whichever
# model is strongest for it (e.g. reasoning on Claude, coding on GPT). It's
# not a switch — they compose. `olympus models` shows the assignment.
# OLYMPUS_MODELS=[{"provider":"openai","model":"gpt-5","api_key":"sk-..."}]

# ── Optional ────────────────────────────────────────────────────────────

# -- Web search providers --
# Explicit provider order. Unavailable providers fall through to the next.
# OLYMPUS_SEARCH_PROVIDERS=bing,google_pse,ddg
# OLYMPUS_SEARXNG_URL=http://localhost:8080
# BRAVE_SEARCH_API_KEY=...
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...                       # Google results through Serper
# GOOGLE_PSE_KEY=...
# GOOGLE_PSE_CX=...
# SERPAPI_API_KEY=...                      # Bing results through SerpApi

# -- Governed browser engine --
# chromium is the default CDP transport. Firefox and WebKit use Playwright.
# safari is an alias for Playwright WebKit, not Apple's Safari application.
# OLYMPUS_BROWSER_ENGINE=chromium          # chromium|firefox|webkit|safari
# OLYMPUS_BROWSER_AUTOLAUNCH=1
# OLYMPUS_BROWSER_HEADLESS=1
# OLYMPUS_BROWSER_CDP_URL=http://127.0.0.1:9222  # Chromium only
# OLYMPUS_BROWSER_BIN=...                  # optional Chromium executable
# OLYMPUS_MEMORY_DIR=./memory
# OLYMPUS_AUDIT_EVERY_CHATS=20               # self-audit cadence (0 = off)
# Budget guard — protects YOUR API bill (BYOK), never a charge from us. Olympus
# pauses new requests once today's estimated spend reaches this. UNSET is safe:
# it falls back to a bounded $10/day ceiling. Removing the ceiling is explicit —
# `0` (or `unlimited`/`none`/`off`) means UNLIMITED, not off.
# Also settable at runtime: `olympus budget <amount>` (which takes precedence).
# OLYMPUS_DAILY_BUDGET=5
# Ceiling on operator-funded free chats per client IP per day. OLYMPUS_FREE_CHATS
# is charged to the caller's identity, which for an anonymous visitor is derived
# from their own cookie — so without this a caller could clear the cookie and mint
# a fresh allowance forever. Defaults to 3x OLYMPUS_FREE_CHATS; <=0 disables.
# OLYMPUS_FREE_CHATS_PER_IP=9
# Per-IP per-minute ceiling for the /v1 OpenAI/Anthropic-compatible endpoints.
# Looser than OLYMPUS_RATE_LIMIT on purpose: /v1 is programmatic and bursts.
# OLYMPUS_V1_RATE_LIMIT=120
# OLYMPUS_RUN_BUDGET_USD=                    # per-run USD ceiling (0/unset = off)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_CHAT_IDS=12345,67890
# TELEGRAM_NOTIFY_CHAT_ID=12345

# ── Talk to Olympus on WhatsApp (official Cloud API) ────────────────────
# Create a Meta app + WhatsApp product, then `olympus whatsapp` serves the
# webhook (put it behind HTTPS and point Meta's webhook at https://host/webhook).
# WHATSAPP_ACCESS_TOKEN=EAAG...               # Graph API token
# WHATSAPP_PHONE_NUMBER_ID=123456789          # the sending number's ID
# WHATSAPP_VERIFY_TOKEN=any-secret-you-choose # echoed during webhook setup
# WHATSAPP_ALLOWED_NUMBERS=15551234567        # restrict who may talk to it
# WHATSAPP_APP_SECRET=...                      # verify inbound signatures (optional)

# ── Auto-file upgrade proposals as GitHub issues ────────────────────────
# GITHUB_TOKEN=ghp_...                       # needs Issues write access
# GITHUB_REPO=maadjiba24-afk/Olympus-

# ── Shadow execution mode (Phase 5 staging) ─────────────────────────────
# OFF by default. When on, Olympus runs the REAL decision path — routing,
# planning, verification, journaling, tracing — but every external side effect
# is intercepted at one boundary (olympus/shadow.py): reads and Olympus-local
# writes still run, safe-to-simulate effects are recorded instead of performed,
# and anything needing a human approval boundary (or anything irreversible or
# financial) is refused. An unclassified tool is refused by default.
# Responses carry X-Olympus-Mode: shadow so a shadow run is never mistakable
# for a production one.
# OLYMPUS_SHADOW_MODE=1

# ── Hosted web instance protection ──────────────────────────────────────
# With NEITHER of the next two set, the browser API (/api/*) is loopback-only:
# an off-box peer, or a server bound off-loopback, or a request relayed through
# a reverse proxy, is refused rather than served anonymously. Setting either one
# is what makes the surface reachable from elsewhere. (/v1/* and /api/admin have
# always behaved this way; the browser API joined them in the Phase-4 review.)
# OLYMPUS_ACCESS_TOKEN=choose-a-secret       # require token in the web UI
# OLYMPUS_REQUIRE_LOGIN=1                     # require per-user accounts (login)
# OLYMPUS_SESSION_DAYS=30                     # how long a login session lasts
# OLYMPUS_RATE_LIMIT=8                       # chat requests per IP per minute
# OLYMPUS_MAX_CONCURRENT_CALLS=6             # process-wide model-call cap
# OLYMPUS_JUDGE_MODEL=claude-sonnet-4-6      # benchmark judge (≠ tuned model)
# OLYMPUS_RETAIN_DAYS=30                     # keep trace/usage files this long

# ── Conversation retention (NO DEFAULT — an operator decision) ───────────
# Governs conversation snapshots and their sealed journals, which
# OLYMPUS_RETAIN_DAYS does NOT cover. Olympus ships no default here on purpose:
# the right period depends on your jurisdiction, contract, and what you told
# your users, and guessing would invent a legal position that is not ours to
# invent. UNSET is a reported state, not a silent "keep forever" — while it is
# unset, `olympus retention status` exits non-zero and reports the deployment
# BLOCKED for regulated or multi-user personal data.
# Set a number of days, or the literal `forever` if indefinite retention is
# your deliberate, disclosed policy. Either is a decision on record.
# OLYMPUS_CONVERSATION_RETAIN_DAYS=90
#
# Principals exempt from EVERY deletion path (comma-separated). A litigation or
# regulatory hold outranks both retention sweeps and a deletion request.
# OLYMPUS_LEGAL_HOLD=alice,api-3fa9c2

# ── Connectors: MCP servers & custom plugins ────────────────────────────
# Configure MCP servers in memory/connectors.json (see examples/) or inline:
# OLYMPUS_MCP_SERVERS={"servers":[{"name":"tavily","url":"https://mcp.tavily.com/mcp/","type":"data","auth_env":"TAVILY_MCP_TOKEN","specialists":["argus"]}]}
# TAVILY_MCP_TOKEN=tvly-...                  # token referenced by auth_env
# OLYMPUS_PLUGINS_DIR=./plugins              # local custom-connector plugins
# Action MCP servers are INERT until named here (double gate, like email):
# OLYMPUS_MCP_ACTION_ALLOWLIST=github,linear

# ── Connect Google with OAuth (self-serve, multi-user) ──────────────────
# Create an OAuth client in Google Cloud Console, then set these. Users click
# "Connect Google" in the web UI; tokens are stored ENCRYPTED in the vault.
# OLYMPUS_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# OLYMPUS_GOOGLE_CLIENT_SECRET=...
# OLYMPUS_GOOGLE_REDIRECT=http://localhost:8484/oauth/google/callback
# OLYMPUS_SECRET_KEY=any-strong-stable-secret   # encrypts stored credentials

# ── Hard output contracts (off by default) ─────────────────────────────
# Enforce per-specialist output contracts (size/JSON-schema/tool-call caps) at
# the orchestrator before a specialist's output is accepted. A violation fails
# closed (that part is treated as missing) and is recorded as a signed
# `contract` decision in the existing decision log. Inert unless turned on, and
# ships with every specialist at contract=None (zero behavior change).
# OLYMPUS_CONTRACTS=1

# ── Egress gateway (off by default — boundary layer, Phase A) ───────────
# Route outbound EMAIL and WEBHOOK sends through the egress gateway: classify
# the payload (regex-based, deterministic) and, if it carries secrets/keys
# (SENSITIVE), HOLD it for explicit approval on the actions spine instead of
# sending. Within-policy sends are unchanged. Inert unless turned on; every
# decision is recorded as a signed `egress` decision in the existing log.
# (Phase A wires _send_email + _call_webhook only — see docs/DESIGN_BOUNDARY_LAYER.md.)
# OLYMPUS_EGRESS_GUARD=1

# ── Real database (optional — defaults to local files) ──────────────────
# Set a Postgres URL to persist the vault/state in a database instead of files.
# OLYMPUS_DATABASE_URL=postgresql://user:pass@host:5432/olympus

# ── Durable memory (on by default) ──────────────────────────────────────
# OLYMPUS_MEMORY=0                           # turn off learning entirely
# Optional semantic recall: point at ANY OpenAI-compatible /embeddings endpoint
# (OpenAI, a local Ollama/LM Studio server, ...). Off unless a model is set;
# retrieval stays purely lexical otherwise.
# OLYMPUS_EMBED_MODEL=text-embedding-3-small
# OLYMPUS_EMBED_BASE_URL=https://api.openai.com/v1   # or http://localhost:11434/v1
# OLYMPUS_EMBED_API_KEY=sk-...                # falls back to OLYMPUS_API_KEY/OPENAI_API_KEY

# ── Native adaptive extensions (all opt-in, off by default) ─────────────
# Each is replay-safe and degrades to today's behaviour when unset.
# OLYMPUS_ANN=1                              # HNSW vector index for semantic recall at scale
# OLYMPUS_SWARM=1                            # topology-driven consultation pass after dispatch
# OLYMPUS_SWARM_TOPOLOGY=star                # star | mesh | hierarchical | ring
# OLYMPUS_CONSENSUS=1                        # multi-verifier quorum verification
# OLYMPUS_CONSENSUS_VERIFIERS=3              # verifier fan-out (odd, ≤7)
# OLYMPUS_BANDIT_ROUTING=1                   # UCB1 explore/exploit model routing
# OLYMPUS_SEMANTIC_ROUTING=1                 # relevance-order the agent roster (needs embeddings; scales with file agents)
# OLYMPUS_AGENTS=1                           # load file-defined agents from OLYMPUS_AGENTS_DIR
# OLYMPUS_AGENTS_DIR=./agents                # <key>.md agent definitions (default <MEMORY_DIR>/agents)

# ── Federation (cross-instance, opt-in) ─────────────────────────────────
# Mutually-authenticated links to other Olympus instances (ADR 0007). Signed
# with the witness ed25519 subkey; inbound listener is bearer-token fail-closed.
# OLYMPUS_FEDERATION=1                        # enable calling peers + serving endpoints
# OLYMPUS_FEDERATION_NAME=my-olympus          # this instance's advertised name
# OLYMPUS_FEDERATION_TOKEN=choose-a-secret    # inbound bearer token (required to serve)

# ── Gmail (direct token — alternative to the OAuth flow above) ───────────
# Connect a Google account so Angelos can read the inbox and PREPARE replies
# (sending always goes through the approval gate). Short-lived token for
# testing, or a refresh token + client creds for unattended auto-refresh.
# GMAIL_ACCESS_TOKEN=ya29....
# GMAIL_REFRESH_TOKEN=1//...
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...

# ── Action tools (disabled until configured) ────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=you@gmail.com
# OLYMPUS_EMAIL_ALLOWLIST=you@gmail.com      # the ONLY addresses it may email
# OLYMPUS_WEBHOOKS=poster=https://hooks.zapier.com/...,notify=https://...

# ── Wave 1: Colibri-absorption measurement substrate ────────────────────
# (all default to safe/off; see docs/absorption/WAVE1_IMPLEMENTATION_SPEC.md)
# Sealed session journal (crash-safe append-only history; default on, additive)
# OLYMPUS_SESSION_JOURNAL=on                 # off = disable journaling + recovery
# OLYMPUS_SESSION_FSYNC=auto                 # auto = fsync at turn-end; always = per record
# OLYMPUS_SESSION_JOURNAL_MAX_MB=64          # recovery refuses beyond this; compact to clear
# Calibrated context budgeting (default off => byte-identical chars//4)
# OLYMPUS_CTX_BUDGET=off                     # on = calibrated estimator + refusal-over-truncation
# OLYMPUS_CTX_OUTPUT_RESERVE_FRACTION=0.20   # share of the window reserved for output
# OLYMPUS_CTX_REPAIR_RESERVE=0               # extra tokens reserved for retry/repair context
# Prompt-cache telemetry pricing (published-price defaults; no TTLs are hardcoded)
# OLYMPUS_CACHE_READ_MULT=0.1                # cache-read priced at input_price x this
# OLYMPUS_CACHE_WRITE_MULT=1.25              # cache-creation priced at input_price x this
# Tool-call recovery ladder
# OLYMPUS_TOOL_VALIDATE=on                   # off = legacy pass-through (no schema validation)
# OLYMPUS_TOOL_SALVAGE=off                   # on = map a lone payload onto a single required param
# OLYMPUS_REPAIR_WARN_RATE=0.15              # doctor WARN when 7d rung>=3 share exceeds this
# Provider-drift tripwire (default off; shares the measurement budget)
# OLYMPUS_DRIFT_GATE_EVERY=0                 # seconds between heartbeat drift runs (0 = off)
# OLYMPUS_DRIFT_BUDGET_USD=1.0               # hard per-run dollar cap for the drift gate
# OLYMPUS_COMMIT=                            # optional commit id stamped into drift results (CI sets it)

# ── Wave-2 absorption capabilities ──────────────────────────────────────
# (all default to safe/off; see docs/absorption/WAVE2_IMPLEMENTATION_SPEC.md)
# Unified admission policy (W2-C7) — one policy on the ONE slot primitive
# (ruling R3). Default OFF: `usage.slot()` then behaves exactly as before.
# Overload is refused with 429 + Retry-After, never silently downgraded (R6).
# OLYMPUS_ADMISSION=off                      # on = queueing, priorities, fairness, refusals
# OLYMPUS_ADMISSION_PROVIDER_MAX=0           # max concurrent calls per provider (0 = unlimited)
# OLYMPUS_ADMISSION_MODEL_MAX=0              # max concurrent calls per model (0 = unlimited)
# OLYMPUS_ADMISSION_TENANT_MAX=0             # max concurrent calls per user/tenant (0 = unlimited)
# OLYMPUS_ADMISSION_CLASS_MAX=0              # max concurrent calls per workload class (0 = unlimited)
# OLYMPUS_ADMISSION_RESERVE=1                # slots reserved for priority "critical" (alias OLYMPUS_SLOT_RESERVE)
# OLYMPUS_ADMISSION_MAX_QUEUE=64             # max waiters before 429 queue_full (0 = unbounded; alias OLYMPUS_MAX_QUEUE)
# OLYMPUS_ADMISSION_QUEUE_TIMEOUT=300        # max queue wait in seconds (alias OLYMPUS_QUEUE_TIMEOUT)
# OLYMPUS_ADMISSION_SPEND_RATE_MAX=0         # denial-of-wallet ceiling in USD/min per key (0 = off)

# ── Wave 2: evidence-consuming policy (all default OFF or shadow) ───────
# (see docs/absorption/WAVE2_IMPLEMENTATION_SPEC.md; every flag is also
#  registered in olympus/experiments.json with its evidence + review date)
# Measured model qualification — the single evidence ladder. A hand-written
# capability claim can seed a prior but can NEVER promote a model.
# OLYMPUS_MODELGRADE=1                       # enable the grade store (default off)
# OLYMPUS_GRADE_MIN_N=20                     # min measured observations to qualify
# OLYMPUS_GRADE_FLOOR=0.7                    # Wilson lower-bound floor to qualify
# OLYMPUS_GRADE_FLOOR_CODING=0.75            # per-task-class floor override
# OLYMPUS_GRADE_TTL_DAYS=30                  # evidence freshness; 2x TTL => retired
# OLYMPUS_GRADE_HALFLIFE_DAYS=30             # recency half-life for weighting
# OLYMPUS_POLICY_VERSION=1                   # stamped into every evidence row
# Context & skill heat — usefulness-weighted, shadow until calibrated.
# OLYMPUS_CTXHEAT=shadow                     # off | shadow | on (default off)
# OLYMPUS_PIN_BUDGET_TOKENS=                 # max tokens of pinned context
# OLYMPUS_CTXHEAT_HYSTERESIS=                # PROVISIONAL — uncalibrated
# OLYMPUS_CTXHEAT_HALFLIFE_DAYS=             # PROVISIONAL — uncalibrated
# OLYMPUS_CTXHEAT_MAX_PINS=                  # pin-set size cap
# OLYMPUS_CTXHEAT_MAX_SWAPS=                 # swaps per re-pin pass
# OLYMPUS_CTXHEAT_MIN_VERIFIED=              # verifier-accepted uses to protect
# OLYMPUS_CTXHEAT_PROTECT_N=                 # eviction-protection threshold
# Routing substitution — only inside measured quality bands.
# OLYMPUS_ROUTESUB=shadow                    # off | shadow | on (default off)
# OLYMPUS_ROUTESUB_BAND=                     # max quality gap allowed
# OLYMPUS_ROUTESUB_QUALITY_FLOOR=            # raise the per-cell floor
# OLYMPUS_ROUTESUB_VERIFIER_FLOOR=0.90       # Aletheia's hard floor (never below)
# OLYMPUS_ROUTESUB_PROTECT_VERIFIER=1        # 0 = allow verify-role substitution
# OLYMPUS_ROUTESUB_CONFIDENCE=               # min card confidence to substitute
# OLYMPUS_ROUTESUB_TTL_DAYS=                 # evidence freshness for substitution
# OLYMPUS_ROUTESUB_CLASSES=                  # security classes that may substitute
# OLYMPUS_ROUTESUB_EST_TOKENS=               # PROVISIONAL savings-estimate basis
# Persistent-artifact ingestion gate (reject-never-repair).
# OLYMPUS_INGESTGATE=1                       # enforce (default off = pass-through)
# Progress-based watchdog. ALL thresholds are PROVISIONAL until Phase-4
# reliability validation calibrates them.
# OLYMPUS_WATCHDOG=observe                   # off | observe | enforce (default off)
# OLYMPUS_WATCHDOG_STALL_SECS=300            # no progress + no spend => deadlock
# OLYMPUS_WATCHDOG_RETRY_MAX=5               # retry-loop trip
# OLYMPUS_WATCHDOG_IDENTICAL_MAX=3           # identical repeated calls
# OLYMPUS_WATCHDOG_STREAM_STALL_SECS=45      # stalled stream
# OLYMPUS_WATCHDOG_MAX_TOOL_DEPTH=8          # runaway tool recursion
# OLYMPUS_WATCHDOG_SPEND_RATE_USD=0.05       # denial-of-wallet rate (usd/s)
# OLYMPUS_WATCHDOG_SPEND_WINDOW_SECS=30      # rate window (avoids false trips)
# OLYMPUS_WATCHDOG_CALL_CEILING_SECS=600     # provider hang ceiling
# OLYMPUS_WATCHDOG_VERIFY_CYCLE_MAX=3        # verifier loop
# OLYMPUS_WATCHDOG_PROGRESS_FREE_USD=0.25    # spend with zero accepted progress
# OLYMPUS_WATCHDOG_QUEUE_WAIT_SECS=120       # queue starvation
# Degenerate-stream defense (distinct from OLYMPUS_STREAM_GUARD, the egress
# hold-back filter — this one guards against pathological provider streams).
# OLYMPUS_STREAMGUARD=1                      # enable detectors (default off)
# OLYMPUS_STREAM_LOOP_REPEATS=12             # consecutive n-gram repeats
# OLYMPUS_STREAM_EMPTY_DELTAS=200            # consecutive empty deltas
# OLYMPUS_STREAM_WS_RUN=4096                 # consecutive whitespace chars
# OLYMPUS_STREAM_PARTIAL_JSON=32             # never-parsing tool-arg attempts
# OLYMPUS_STREAM_CHARS_PER_TOKEN=            # output-bound estimate basis

# ── Pre-existing knobs surfaced by the absorption drift guard ───────────
# These were read by the code but undocumented until the Wave-2 derived
# env guard found them (tests/test_wave1_env_docs.py). They are part of
# the decision-path flag set that replay reproduces and that modelgate
# fingerprints, so an operator changing one changes measured evidence.
# OLYMPUS_REPLAY=<run_id>                    # replay mode: serve frozen responses
# OLYMPUS_FAST=1                             # fast mode: skip the review stage
# OLYMPUS_INTERACTIVE_VERIFY=on              # bounded-latency direct-answer check
# OLYMPUS_ABC=on                             # ACE-based history compaction
# OLYMPUS_INRUN_COMPACT=1                    # compact tool transcripts mid-run
# OLYMPUS_INRUN_BUDGET=24000                 # in-run transcript budget (chars)
# OLYMPUS_INRUN_KEEP_RECENT=                 # recent tool results kept verbatim
# OLYMPUS_SEMANTIC_SKILLS=1                  # relevance-scope the skill index
# OLYMPUS_LEARNED_ROUTING=1                  # outcome-learned specialist routing
# OLYMPUS_JOB_STALL_SECS=                    # background-job stall threshold
