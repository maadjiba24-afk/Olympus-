# OLYMPUS — staging environment (Phase 5). Copy to `.env.staging` and fill in.
#
# `.env.staging` is git-ignored. Secrets NEVER enter source control; this file
# ships the shape only. Every value below that has no default is REQUIRED —
# `config.require_staging_config()` refuses to start without it and names what
# is missing.

# ── mode ────────────────────────────────────────────────────────────────────
# Set by the compose file too, so the profile cannot be turned into production
# by swapping this file. Do not change it.
OLYMPUS_ENV=staging

# Shadow mode: run the real decision path, intercept every external side
# effect. Required for the staging evidence campaign. See PHASE5 spec §7–§8.
OLYMPUS_SHADOW_MODE=1

# ── durable state (REQUIRED) ────────────────────────────────────────────────
# Must point at the mounted volume. Left unset, durable state lands inside the
# image and is destroyed on the next container restart.
OLYMPUS_MEMORY_DIR=/app/memory

# ── spend cap (REQUIRED, must be > 0) ───────────────────────────────────────
# NOTE: 0 means UNLIMITED, not off. Staging runs unattended, so an unbounded
# budget is a denial-of-wallet waiting to happen. Boot refuses 0 or unset.
OLYMPUS_DAILY_BUDGET=5.00

# Bound the parallel provider fan-out. The measured usage-ledger contention
# limit is 16 concurrent provider calls per host (PRODUCTION_READINESS_REPORT
# §4); above that the ledger lock, not the provider, becomes the limiter.
OLYMPUS_MAX_CONCURRENT_CALLS=6

# ── exposure (REQUIRED when binding off-loopback) ───────────────────────────
# The compose profile binds 0.0.0.0 inside the container, so at least one
# credential must be configured or every request is refused. Generate real
# random values — these are staging keys and must never equal production keys.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OLYMPUS_API_KEYS=REPLACE_ME_staging_key_1,REPLACE_ME_staging_key_2
OLYMPUS_ACCESS_TOKEN=REPLACE_ME_browser_api_token

# Optional. The CLI boot check runs before any command knows what it will bind,
# so it cannot see `web --host`. Setting this lets the credential check fail at
# BOOT instead of when `serve()` is finally reached — useful under compose,
# where a late failure looks like a crash loop. `serve()` re-checks with the
# real host regardless, so leaving this unset is safe, just later-failing.
OLYMPUS_BIND_HOST=0.0.0.0

# ── retention (must be finite) ──────────────────────────────────────────────
# Governs traces, usage, frozen payloads and the absorption evidence ledgers.
# 0 or negative disables the sweep and is refused at boot.
OLYMPUS_RETAIN_DAYS=14

# ── provider credentials (optional — leave unset for a $0 campaign) ─────────
# With none set, staging runs against stub providers: infrastructure is
# exercised, evidence is labelled `shadow-provider`, and no real card is
# written. Set one to run the real provider-qualification campaign, and expect
# it to spend up to OLYMPUS_DAILY_BUDGET.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
OLYMPUS_MODEL=claude-opus-4-8

# ── build identification ────────────────────────────────────────────────────
# The container has no .git, so `build_info()` cannot derive the commit.
# Stamp it: OLYMPUS_BUILD_COMMIT=$(git rev-parse HEAD)
OLYMPUS_BUILD_COMMIT=

# A staging-only encryption key is required before backup/recovery evidence can
# pass. Never reuse the production key.
OLYMPUS_SECRET_KEY=REPLACE_ME_staging_only_secret

# P2A readiness thresholds. The named deployment remains not-ready until the
# operator completes the lifecycle and backup drill in DEPLOYMENT_READINESS.md.
OLYMPUS_MIN_FREE_BYTES=1073741824
OLYMPUS_BACKUP_MAX_AGE=172800
OLYMPUS_DURABILITY_EVIDENCE_MAX_AGE=2592000
OLYMPUS_DURABILITY_CHALLENGE_MAX_AGE=86400
OLYMPUS_BACKUP_EVERY=86400

# ── signing ─────────────────────────────────────────────────────────────────
# On the public default seed, signatures prove integrity but NOT authenticity.
# That is acceptable for staging and refused for production. Provision a
# staging-only seed if you intend to verify staging attestations.
# OLYMPUS_SIGNING_SEED_FILE=/run/secrets/olympus_signing_seed

# ── explicitly NOT set in staging ───────────────────────────────────────────
# OLYMPUS_BACKUP_CMD  — must point at a STAGING-ONLY destination. Boot refuses
#                       it unless the explicit allow flag below is also set.
# P2A readiness remains not-ready until these are configured and exercised:
# OLYMPUS_STAGING_ALLOW_BACKUP_CMD=1
# OLYMPUS_BACKUP_CMD=rclone copy {path} spaces:olympus-staging-backups/
# Any connector credential (Slack, Gmail, GitHub, …) — shadow mode intercepts
# external effects, but the safest configuration is to have no live credential
# present at all. Defence in depth, not either/or.
