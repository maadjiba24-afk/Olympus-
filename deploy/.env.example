# Copy to `.env` and fill in. NEVER commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# ── Required ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                 # your model API key (billed to you)
OLYMPUS_ACCESS_TOKEN=REPLACE_WITH_RANDOM_HEX # gate so only people with this can enter
OLYMPUS_SECRET_KEY=REPLACE_WITH_RANDOM_HEX   # encrypts stored OAuth tokens (the vault)
OLYMPUS_MEMORY_DIR=/app/memory               # matches the persisted volume

# ── Recommended for a public instance ───────────────────────────────────
OLYMPUS_REQUIRE_LOGIN=1                       # require per-user accounts (register/login)
OLYMPUS_RATE_LIMIT=8                          # chat requests per IP per minute
OLYMPUS_DAILY_CHATS=50                        # max chats per user per day (0 = unlimited)
OLYMPUS_MAX_CONCURRENT_CALLS=6               # process-wide model-call cap
OLYMPUS_DAILY_BUDGET=20                       # stop spending past $20/day on YOUR key
# Cost protection. Two ways to bound spend on YOUR key:
#  - FREE ALLOWANCE (recommended): give each visitor a few free chats on your
#    key, then they continue on their own (bring-your-own-key). Set FREE_CHATS.
#  - ALL-OR-NOTHING: require a key from everyone (no free chats). Set REQUIRE_BYOK=1.
# If OLYMPUS_FREE_CHATS > 0 it takes precedence (BYOK becomes a limit, not a wall).
OLYMPUS_FREE_CHATS=5                          # free operator-funded chats/user/day, then BYOK
# OLYMPUS_REQUIRE_BYOK=1                      # or: every visitor must bring their own key
# Shown on the /privacy and /terms pages (and required by Google for a
# production OAuth app that reads Gmail/Calendar).
OLYMPUS_OPERATOR_NAME=Your Name or Company
OLYMPUS_OPERATOR_CONTACT=you@example.com

# ── Off-droplet backups — survive losing the machine (see docs/BACKUPS.md) ─
# The heartbeat archives MEMORY_DIR (memory, accounts, encrypted OAuth tokens,
# the signed decision log), encrypts it with OLYMPUS_SECRET_KEY, signs it, and
# hands it to this command for off-machine delivery. {path} = the archive path.
# Without a command the backup is kept LOCAL ONLY (no protection against losing
# the droplet). Bring any uploader (rclone/aws/scp):
# OLYMPUS_BACKUP_CMD=rclone copy {path} spaces:olympus-backups/
# OLYMPUS_BACKUP_EVERY=86400                 # seconds between backups (daily); 0 disables
# OLYMPUS_BACKUP_KEEP=7                       # local archives to retain
# OLYMPUS_BACKUP_ALLOW_PLAINTEXT=1           # only if you have no SECRET_KEY and trust the dest

# ── Google (item #3) — fill when you set up the OAuth client ─────────────
# OLYMPUS_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# OLYMPUS_GOOGLE_CLIENT_SECRET=...
# OLYMPUS_GOOGLE_REDIRECT=https://caelarion.com/oauth/google/callback

# ── WhatsApp (item #4) — fill when you set up the Meta app ───────────────
# Run the gateway as a separate process/container; webhook is https://caelarion.com/webhook
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_VERIFY_TOKEN=...
